# Environment Variables Configuration
# 复制为 .env 并填入真实密钥；config.yaml 中对应字段保持占位即可。
# 优先级：进程环境变量 > .env > config.yaml
# 加载入口：src/config.py 的 load_config()（自动读取项目根目录 .env）

# WeChat Official Account
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_appsecret

# LLM - OpenAI 兼容端点（当前项目指向 DashScope）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (可选)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# DashScope 图像生成（src/dashscope_image_gen.py 直接读取）
DASHSCOPE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 智谱AI
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4

# SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2-7B-Instruct

# Agnes (Sapiens AI) - 封面图生成
AGNES_API_KEY=

# Exa Search API (optional)
EXA_API_KEY=your_exa_api_key_here

# 免费图片 API
PEXELS_API_KEY=
ZIMAGE_API_KEY=

# 代理 (optional, src/proxy.py 直接读取)
# HTTP_PROXY=
# HTTPS_PROXY=

# WeCom (optional)
WECOM_CORP_ID=your_corp_id
WECOM_CORP_SECRET=your_wecom_corp_secret
WECOM_AGENT_ID=your_agent_id

# 监控告警 webhook（src/config_secure.py / monitoring.py，可选）
SLACK_WEBHOOK=
FEISHU_WEBHOOK=

# DingTalk (optional)
DINGTALK_WEBHOOK=your_dingtalk_webhook
DINGTALK_SECRET=your_dingtalk_secret

# Email (optional)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM_ADDR=your_email@gmail.com
EMAIL_TO_ADDRS=recipient1@example.com,recipient2@example.com
