# 微信公众号配置
wechat:
  app_id: "your_app_id_here"
  app_secret: "your_app_secret_here"

# LLM 配置 - 兼容 OpenAI /chat/completions 的任意服务商
# provider 可选: auto, agnes, deepseek, zhipu, siliconflow, openrouter, openai
# auto = 按 agnes > deepseek > zhipu > siliconflow > openrouter > openai 顺序
#        挑第一个配了 key 的；model 留空则用该提供商默认模型
llm:
  provider: "auto"
  model: ""

openai:
  api_key: "your_openai_api_key_here"
  model: "gpt-4o-mini"

# DeepSeek (推荐 - 免费额度多)
deepseek:
  api_key: ""  # https://platform.deepseek.com/
  model: "deepseek-chat"

# 智谱AI (免费额度)
zhipu:
  api_key: "your_zhipu_api_key_here"  # https://open.bigmodel.cn/
  model: "glm-4"

# SiliconFlow (便宜)
siliconflow:
  api_key: ""  # https://siliconflow.cn
  model: "Qwen/Qwen2-7B-Instruct"

# Agnes (Sapiens AI) - 封面图生成 + 文本模型（同一把 key）
agnes:
  api_key: ""  # https://api.agnes-ai.cn/
  # base_url: "https://api.agnes-ai.cn/v1"   # 文本 + 出图共用；换代理/自建网关时改这里
  model: "agnes-image-2.5-flash"   # 封面图模型
  text_model: "agnes-3.0-flash"    # 文本模型（llm.provider=agnes 时使用）

# 阿里通义万相 Z-Image (国内)
zimage:
  api_key: "your_zimage_api_key_here"

news:
  search_keywords:
    - "AI 人工智能"
    - "大语言模型 LLM"
    - "GPT OpenAI"
    - "大模型 国产"
    - "AI 科技"
  max_results_per_search: 10
  max_news: 24
  exclude_keywords:
    - "广告"
    - "招聘"
  
  # 国内新闻源
  sources:
    search: false
    rss: false
    hackernews: false
    websites: false
  
  # 国内专用新闻源（只列实测抓得到的站点）
  domestic_sources:
    enabled: true
    baidu: true      # 百度热搜
    36kr: true
    liangzi: true    # 量子位
    huxiu: true

publish:
  author: "AI前沿观察"
  default_cover: ""  # 留空：封面由生成器出图（AI 写实 → 渐变降级）
  default_digest: "每日AI资讯汇总，带你掌握AI行业最新动态"

scheduler:
  enabled: false
  time: "08:00"
  # 每天最多几篇草稿。默认 1（AGENTS.md 红线）；调高前先想清楚降权风险
  max_drafts_per_day: 1
  timezone: "Asia/Shanghai"
